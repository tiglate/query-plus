# =============================================================================
# QueryPlus — local development environment template
# =============================================================================
#
# These values are DUMMY credentials for local Docker / laptop use only.
# Do NOT use them in production, staging, or any shared environment.
#
# Setup:
#   cp .env.example .env
#
# .env is gitignored and must never be committed.
# Docker Compose reads .env automatically for ${VAR} substitution.
# `dotnet run` loads .env from the repo root (if present) into the process.
# =============================================================================

# --- SQL Server (docker-compose sqlserver service) ---
MSSQL_SA_PASSWORD=Your_strong_Password123

# --- Keycloak admin (docker-compose keycloak service, dev mode only) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- OpenBao dev-mode root token (docker-compose openbao/openbao-init services) ---
# Only used for Docker Compose ${...} substitution (seeding OpenBao, and the containerized
# app's own OPENBAO_TOKEN). NOT read directly by the app on the host - the app only talks to
# OpenBao when its own process environment also has OPENBAO_ADDR set (true inside the
# docker-compose "full" profile; false for plain `dotnet run`, which keeps reading the plain
# env vars below instead). Do NOT add an OPENBAO_ADDR entry here for that reason.
OPENBAO_TOKEN=dev-only-token

# --- ASP.NET Core (double-underscore = nested configuration) ---
# Read directly by the app for the routine `dotnet run` (host) dev flow. The containerized
# app (docker-compose "full" profile) does NOT use these - it fetches the equivalent values
# from OpenBao instead (seeded by the openbao-init service from MSSQL_SA_PASSWORD/
# Keycloak__ClientSecret above/below).
# Host machine: SQL published on localhost:1433
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=QueryPlus;User Id=sa;Password=Your_strong_Password123;TrustServerCertificate=True;Encrypt=False

Keycloak__Authority=http://localhost:8080/realms/queryplus
Keycloak__ClientId=queryplus-web
# Must match docker/keycloak/realm-export.json client secret for local realm import.
Keycloak__ClientSecret=change-me-in-production
Keycloak__RequireHttpsMetadata=false

# Uncomment when the app runs inside Docker (Compose profile "full" / Dev Container):
# ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=QueryPlus;User Id=sa;Password=Your_strong_Password123;TrustServerCertificate=True;Encrypt=False
# Keycloak__MetadataAddress=http://keycloak:8080/realms/queryplus/.well-known/openid-configuration
# Keycloak__BackchannelHost=keycloak
# Keycloak__BackchannelPort=8080

# --- Jobs module (Linux only; QueryPlus.Api, QueryPlus.Runner, QueryPlus.SchedulerSync all read
# these) - see docs/local/jobs-module-deployment.md. Absolute paths only.
# Jobs__ScriptAllowlistRoot=/opt/queryplus/scripts
# Jobs__LogRoot=/opt/queryplus/App_Data/jobs

# --- SMTP (job failure / missed-trigger notifications) ---
# Defaults below match the docker-compose "mailpit" service's published ports (127.0.0.1:1025) -
# `docker compose up -d mailpit` then browse http://localhost:8025 to see what QueryPlus.Runner/
# QueryPlus.SchedulerSync send, without a real mail provider. No auth needed for local
# submission, so Smtp__Username/Smtp__Password stay unset.
# Smtp__Host=localhost
# Smtp__Port=1025
# Smtp__EnableSsl=false
# Smtp__FromAddress=queryplus-jobs@example.local
