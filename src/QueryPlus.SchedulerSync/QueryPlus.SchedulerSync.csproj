<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Microsoft.Data.SqlClient (via EF Core and Dapper) throws
         "Globalization Invariant Mode is not supported" opening a connection when this is
         true - this process must talk to real SQL Server, so it cannot run invariant. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QueryPlus.Hosting\QueryPlus.Hosting.csproj" />
    <ProjectReference Include="..\QueryPlus.Application\QueryPlus.Application.csproj" />
    <ProjectReference Include="..\QueryPlus.Data\QueryPlus.Data.csproj" />
    <ProjectReference Include="..\QueryPlus.Infrastructure\QueryPlus.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
