{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "SeedDemoDataOnStartup": false
  },
  "Jobs": {
    "ScriptAllowlistRoot": "/opt/queryplus/scripts",
    "LogRoot": "",
    "HeartbeatIntervalSeconds": 20,
    "WatchdogLookbackMinutes": 60,
    "WatchdogStaleHeartbeatMinutes": 5,
    "EnforceRunAsUserCatalog": true,
    "DenylistedRunAsUsers": []
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": ""
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/queryplus",
    "MetadataAddress": null,
    "BackchannelHost": null,
    "BackchannelPort": 8080,
    "ClientId": "queryplus-web",
    "ClientSecret": "",
    "RequireHttpsMetadata": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
